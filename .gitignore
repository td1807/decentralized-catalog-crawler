# The crawler's output database and WAL files - regenerated by running it.
data/
*.db
*.db-wal
*.db-shm

# The mock provider's PRIVATE KEY.
# A real provider's signing key must never be committed to source control;
# it belongs in a KMS or HSM. Excluding it here keeps that habit visible.
mock_provider/private_key.pem

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Tooling
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
